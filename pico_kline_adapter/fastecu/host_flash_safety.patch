 #include "flash_ecu_subaru_denso_sh705x_kline.h"
 #include "serial_port_actions.h"
 
+#include <cstddef>
+#include <cstdint>
+#include <QFileInfo>
+
+namespace {
+// 2026-09-07: Validate complete kernel replies before treating them as ACKs.
+// BEGIN PURE KERNEL FRAME VALIDATOR
+enum class KernelFrameStatus { Valid, Short, Header, Length, Checksum, Negative, Command, Payload };
+
+KernelFrameStatus checkKernelFrame(const uint8_t *data, std::size_t size,
+                                  uint8_t command, std::size_t payloadSize)
+{
+    if (size < 6)
+        return KernelFrameStatus::Short;
+    if (data[0] != 0xbe || data[1] != 0xef)
+        return KernelFrameStatus::Header;
+    const std::size_t declared = (std::size_t(data[2]) << 8) | data[3];
+    if (declared == 0 || size != declared + 5)
+        return KernelFrameStatus::Length;
+    uint8_t checksum = 0;
+    for (std::size_t i = 0; i + 1 < size; ++i)
+        checksum = uint8_t(checksum + data[i]);
+    if (checksum != data[size - 1])
+        return KernelFrameStatus::Checksum;
+    if (data[4] == 0x7f)
+        return KernelFrameStatus::Negative;
+    if (data[4] != uint8_t(command | 0x40))
+        return KernelFrameStatus::Command;
+    if (declared != payloadSize + 1)
+        return KernelFrameStatus::Payload;
+    return KernelFrameStatus::Valid;
+}
+// END PURE KERNEL FRAME VALIDATOR
+
+QString kernelReplyError(const QByteArray &reply, uint8_t command, std::size_t payloadSize)
+{
+    const auto status = checkKernelFrame(
+        reinterpret_cast<const uint8_t *>(reply.constData()),
+        std::size_t(reply.size()), command, payloadSize);
+    if (status == KernelFrameStatus::Valid)
+        return QString();
+    QString reason;
+    switch (status) {
+    case KernelFrameStatus::Short: reason = "missing or truncated reply"; break;
+    case KernelFrameStatus::Header: reason = "invalid BE EF header"; break;
+    case KernelFrameStatus::Length: reason = "declared and received lengths differ"; break;
+    case KernelFrameStatus::Checksum: reason = "reply checksum mismatch"; break;
+    case KernelFrameStatus::Command: reason = "unexpected response command"; break;
+    case KernelFrameStatus::Payload: reason = "unexpected response payload length"; break;
+    case KernelFrameStatus::Negative:
+        reason = "kernel rejected the request";
+        if (reply.size() >= 8) {
+            const uint8_t rejectedCommand = uint8_t(reply.at(5));
+            const uint8_t code = uint8_t(reply.at(6));
+            reason += QString(" (command 0x%1, detail 0x%2)")
+                .arg(rejectedCommand, 2, 16, QLatin1Char('0'))
+                .arg(code, 2, 16, QLatin1Char('0'));
+            if (rejectedCommand == SUB_KERNEL_FLASH_ENABLE || rejectedCommand == SUB_KERNEL_FLASH_DISABLE)
+                reason += "; flash initialization failed: check kernel silicon variant and flash-enable conditions";
+        }
+        break;
+    default: break;
+    }
+    return QString("Kernel command 0x%1: %2. Raw reply: %3")
+        .arg(command, 2, 16, QLatin1Char('0')).arg(reason, QString::fromLatin1(reply.toHex(' ')));
+}
+
+bool isDedicatedD2wdKernel(const QString &path)
+{
+    return QFileInfo(path).fileName() == "ssmk_kline_sh7055_180_d2wd.bin";
+}
+
+QString kernelIdentityError(const QByteArray &reply, const QString &kernelPath)
+{
+    const QString frameError = kernelReplyError(
+        reply, SUB_KERNEL_ID, reply.size() >= 6 ? std::size_t(reply.size() - 6) : 0);
+    if (!frameError.isEmpty())
+        return frameError;
+    const QByteArray identity = reply.mid(5, reply.size() - 6);
+    if (identity.isEmpty())
+        return "Kernel returned an empty identity.";
+    if (isDedicatedD2wdKernel(kernelPath)) {
+        // cmd_request_ecuid sends sizeof(kernel_id_string), including one NUL.
+        static const char expected[] = "FastECU SH7055 180nm D2WD610H K-Line v1.01";
+        if (identity != QByteArray(expected, sizeof(expected)))
+            return "The running kernel is not the reviewed D2WD610H 180nm kernel. "
+                   "Operation cancelled. Only restart to load this kernel if no real erase/write "
+                   "was attempted; do not power off an ECU awaiting flash recovery.";
+    }
+    return QString();
+}
+
+QByteArray prepareKernelUpload(const QByteArray &kernelBytes)
+{
+    QByteArray payload = kernelBytes;
+    payload.append(QByteArray(2, '\0'));
+    while ((payload.size() & 3) != 0)
+        payload.append('\0');
+    uint16_t sum = 0;
+    for (int i = 0; i < payload.size(); i += 4) {
+        const uint32_t word = (uint32_t(uint8_t(payload.at(i))) << 24) |
+                              (uint32_t(uint8_t(payload.at(i + 1))) << 16) |
+                              (uint32_t(uint8_t(payload.at(i + 2))) << 8) |
+                              uint32_t(uint8_t(payload.at(i + 3)));
+        sum = uint16_t(sum + word);
+    }
+    const uint16_t checksum = uint16_t(0x5aa5 - sum);
+    payload[payload.size() - 2] = char(checksum >> 8);
+    payload[payload.size() - 1] = char(checksum & 0xff);
+    return payload;
+}
