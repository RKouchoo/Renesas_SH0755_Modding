diff --git a/ldscripts/lkr_subaru_7055_180.ld b/ldscripts/lkr_subaru_7055_180.ld
new file mode 100644
index 0000000..da59b1d
--- /dev/null
+++ b/ldscripts/lkr_subaru_7055_180.ld
@@ -0,0 +1,70 @@
+/* Subaru SH7055 180nm K-Line RAM kernel; GPLv3.
+ *
+ * The sti04 loader uploads a flat binary at FFFF6004. The on-chip flash
+ * erase/write microcodes are downloaded later to FFFF8000 and FFFF8800,
+ * each occupying 2 KiB. Neither executable code, BSS nor stack may overlap
+ * these destinations. BSS is NOLOAD and is cleared by start_ssm.s, so the
+ * microcode reservation is not part of the transmitted binary.
+ *
+ * BSS has 12 KiB at FFFF9000..FFFFBFFF, followed by a dedicated 4 KiB
+ * stack region ending at FFFFCFFF. SH7055 RAM continues through FFFFDFFF;
+ * that final 4 KiB remains unused here (apart from platform die_trace).
+ */
+
+ENTRY(RAMjump_entry)
+
+MEMORY {
+    CODE (rx)   : ORIGIN = 0xFFFF6004, LENGTH = 0x1FFC
+    MICRO (rw)  : ORIGIN = 0xFFFF8000, LENGTH = 0x1000
+    DATA (rw)   : ORIGIN = 0xFFFF9000, LENGTH = 0x3000
+    STACK (rw)  : ORIGIN = 0xFFFFC000, LENGTH = 0x1000
+}
+
+_stackinit = ORIGIN(STACK) + LENGTH(STACK) - 4;
+
+SECTIONS {
+    .text : {
+        . = ALIGN(4);
+        KEEP(*(.rja))
+        *(.text .text.*)
+        . = ALIGN(4);
+        _etext = .;
+    } > CODE
+
+    .rodata : {
+        . = ALIGN(4);
+        *(.rodata .rodata.*)
+        . = ALIGN(4);
+    } > CODE
+
+    .data : {
+        . = ALIGN(4);
+        _sdata = .;
+        *(.data .data.* .sdata .sdata.*)
+        . = ALIGN(4);
+        _edata = .;
+        _idatalen = . - _sdata;
+        _endpayload = .;
+    } > CODE
+
+    .bss (NOLOAD) : {
+        . = ALIGN(4);
+        _sbss = .;
+        *(.bss .bss.* .sbss .sbss.*)
+        *(COMMON)
+        . = ALIGN(4);
+        _ebss = .;
+        _bsslen = . - _sbss;
+    } > DATA
+
+    ASSERT(RAMjump_entry == 0xFFFF6004, "sti04 kernel entry must remain FFFF6004")
+    ASSERT(_sdata == _edata, "unhandled initialized data")
+    ASSERT(_endpayload <= ORIGIN(MICRO), "kernel code overlaps flash microcode")
+    ASSERT(_sbss >= ORIGIN(MICRO) + LENGTH(MICRO), "BSS overlaps flash microcode")
+    ASSERT(_ebss <= ORIGIN(STACK), "BSS consumes reserved 4 KiB stack region")
+    ASSERT(_stackinit == 0xFFFFCFFC, "unexpected SH7055 stack placement")
+
+    /DISCARD/ : {
+        *(.comment)
+    }
+}
