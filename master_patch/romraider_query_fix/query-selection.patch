+package com.romraider.logger.ecu.comms.manager;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertSame;
+
+import java.lang.reflect.Field;
+import java.lang.reflect.InvocationHandler;
+import java.lang.reflect.Method;
+import java.lang.reflect.Proxy;
+import java.util.Map;
+
+import org.junit.Before;
+import org.junit.Test;
+
+import com.romraider.Settings;
+import com.romraider.logger.ecu.comms.query.EcuInitCallback;
+import com.romraider.logger.ecu.comms.query.Query;
+import com.romraider.logger.ecu.definition.EcuAddressImpl;
+import com.romraider.logger.ecu.definition.EcuData;
+import com.romraider.logger.ecu.definition.EcuDataType;
+import com.romraider.logger.ecu.ui.MessageListener;
+import com.romraider.util.SettingsManager;
+
+/** Pending UI selections must survive definition/profile reloads before polling.
+ * These tests never start the query thread or open an ECU connection.
+ */
+public class QueryManagerImplTest {
+    private QueryManagerImpl manager;
+    private EcuData rpm;
+
+    @Before
+    public void setUp() throws Exception {
+        // Avoid loading or saving the operator's settings in an offline test.
+        Field settings = SettingsManager.class.getDeclaredField("settings");
+        settings.setAccessible(true);
+        settings.set(null, new Settings());
+        manager = new QueryManagerImpl(noCalls(EcuInitCallback.class),
+                noCalls(MessageListener.class));
+        rpm = parameter("Engine Speed", "0x00000E");
+    }
+
+    @Test
+    public void reselectedParameterSurvivesPendingRemoval() throws Exception {
+        manager.addQuery("Data", rpm);
+        manager.removeQuery("Data", rpm);
+        manager.addQuery("Data", rpm);
+        assertEquals(1, drain().size());
+    }
+
+    @Test
+    public void repeatedRemovalsDoNotCancelFinalSelection() throws Exception {
+        manager.removeQuery("Data", rpm);
+        manager.removeQuery("Data", rpm);
+        manager.addQuery("Data", rpm);
+        assertEquals(1, drain().size());
+    }
+
+    @Test
+    public void finalDeselectionStillRemovesTheParameter() throws Exception {
+        manager.addQuery("Data", rpm);
+        assertEquals(1, drain().size());
+        manager.removeQuery("Data", rpm);
+        manager.addQuery("Data", rpm);
+        manager.removeQuery("Data", rpm);
+        assertEquals(0, drain().size());
+    }
+
+    @Test
+    public void viewsKeepIndependentSubscriptions() throws Exception {
+        manager.addQuery("Data", rpm);
+        manager.addQuery("Dashboard", rpm);
+        manager.removeQuery("Data", rpm);
+        Map<String, Query> queries = drain();
+        assertEquals(1, queries.size());
+        assertSame(rpm, queries.get("Dashboard_Engine Speed").getLoggerData());
+    }
+
+    @Test
+    public void definitionReloadUsesTheNewParameterObject() throws Exception {
+        manager.addQuery("Data", rpm);
+        assertEquals(1, drain().size());
+        manager.removeQuery("Data", rpm);
+        EcuData replacement = parameter("Engine Speed", "0xFFB000");
+        manager.addQuery("Data", replacement);
+        Map<String, Query> queries = drain();
+        assertEquals(1, queries.size());
+        assertSame(replacement, queries.get("Data_Engine Speed").getLoggerData());
+    }
+
+    @SuppressWarnings("unchecked")
+    private Map<String, Query> drain() throws Exception {
+        Method update = QueryManagerImpl.class.getDeclaredMethod("updateQueryList");
+        update.setAccessible(true);
+        update.invoke(manager);
+        Field queries = QueryManagerImpl.class.getDeclaredField("queryMap");
+        queries.setAccessible(true);
+        return (Map<String, Query>) queries.get(manager);
+    }
+
+    private static EcuData parameter(final String name, String address) {
+        final EcuAddressImpl ecuAddress = new EcuAddressImpl(address, 2, -1);
+        return (EcuData) Proxy.newProxyInstance(EcuData.class.getClassLoader(),
+                new Class<?>[] { EcuData.class }, new InvocationHandler() {
+            public Object invoke(Object proxy, Method method, Object[] args) {
+                if (method.getName().equals("getName")) return name;
+                if (method.getName().equals("getAddress")) return ecuAddress;
+                if (method.getName().equals("getDataType")) return EcuDataType.PARAMETER;
+                throw new AssertionError("Unexpected parameter call: " + method);
+            }
+        });
+    }
+
+    @SuppressWarnings("unchecked")
+    private static <T> T noCalls(Class<T> type) {
+        return (T) Proxy.newProxyInstance(type.getClassLoader(),
+                new Class<?>[] { type }, new InvocationHandler() {
+            public Object invoke(Object proxy, Method method, Object[] args) {
+                throw new AssertionError("Offline test made an unexpected call: " + method);
+            }
+        });
+    }
+}
